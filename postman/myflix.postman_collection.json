    {
      "name": "Log out",
      "item": [
        {
          "name": "Log out A",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/v1/logout",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Same as the app's Log out button. Ends the session, so its refresh token stops working. (An access token is a signed pass: it stays valid until it expires, about an hour, which is why the app also forgets it.)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logged out', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "After log out: refresh is refused",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/v1/token?grant_type=refresh_token",
            "body": {
              "mode": "raw",
              "raw": "{ \"refresh_token\": \"{{refreshToken}}\" }"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('session is over', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    }
