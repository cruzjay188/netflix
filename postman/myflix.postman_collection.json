    {
      "name": "Security checks (RLS)",
      "description": "Proves each account only sees and changes its own rows. Run Auth first.\n\n- **Stranger** = only the publishable key, no login (role anon) → 401.\n- **B** = logged in as account B, trying to read or change account A's rows.\n  Reading is a *filter*: you get [] (200), not an error. Writing someone else's row is a *gate*: 403.\n  Updating or deleting someone else's row finds 0 rows, so nothing happens.",
      "item": [
        {
          "name": "Setup: A saves Arcane",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "return=representation,resolution=merge-duplicates"
              }
            ],
            "url": "{{baseUrl}}/rest/v1/list_entries?on_conflict=user_id,show_id",
            "body": {
              "mode": "raw",
              "raw": "{\"show_id\": \"arcane\", \"rating\": 5}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('A has Arcane', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stranger reads My List → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/rest/v1/list_entries?select=*",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('not logged in = refused', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stranger reads the catalog → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/rest/v1/shows?select=id,title",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('not logged in = refused', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "B reads My List → only B's rows",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/rest/v1/list_entries?select=user_id,show_id",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenB}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "pm.test('every row is B\\'s', () => rows.forEach((r) => pm.expect(r.user_id).to.eql(pm.environment.get('userIdB'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "B asks for A's rows by id → []",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/rest/v1/list_entries?user_id=eq.{{userIdA}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenB}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('RLS filters them out', () => pm.expect(pm.response.json()).to.eql([]));"
                ]
              }
            }
          ]
        },
        {
          "name": "B reads A's profile → []",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/rest/v1/profiles?id=eq.{{userIdA}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenB}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('RLS filters it out', () => pm.expect(pm.response.json()).to.eql([]));"
                ]
              }
            }
          ]
        },
        {
          "name": "B saves a row as A → 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
